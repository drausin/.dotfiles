[user]
    name = Drausin Wulsin
    email = drausin@genesistherapeutics.ai

[alias]
    br = branch
    ci = commit
    co = checkout
    df = diff
    lg = log --graph --decorate --pretty=oneline --abbrev-commit
    last = log -1 HEAD
    me = merge
    pop = stash pop
    st = status -s
    branch-name = rev-parse --abbrev-ref HEAD
    po = "!git push origin $(git branch-name)"

[rerere]
    enabled = true

[color]
    ui = true

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    autocrlf = input
    pager = delta

[push]
    default = simple

[pull]
    default = current
    ff = only
[commit]
    # Sign commits using GPG
    # gpgsign = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    syntax-theme = gruvbox-dark

[diff]
    tool = vimdiff
    algorithm = patience

[merge]
    tool = vimdiff
    conflictstyle = diff3

[credential]
    helper = cache --timeout=3600

[branch]
    autosetuprebase = always

[pager]
    branch = false

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true


# Machine-local, deploy-managed settings (github credential helper, any proxy)
# are written by deploy.sh to ~/.gitconfig.local (untracked) and included here,
# so per-OS paths never land in this tracked file.
[include]
	path = ~/.gitconfig.local
