# macOS-specific zsh config

# Homebrew conda/miniforge (if installed)
CONDA_CANDIDATES=(
    "$HOME/miniconda3"
    "$HOME/miniforge3"
    "/opt/homebrew/Caskroom/miniconda/base"
)
for _conda_prefix in "${CONDA_CANDIDATES[@]}"; do
    if [ -f "$_conda_prefix/bin/conda" ]; then
        __conda_setup="$("$_conda_prefix/bin/conda" 'shell.zsh' 'hook' 2>/dev/null)"
        if [ $? -eq 0 ]; then
            eval "$__conda_setup"
        else
            if [ -f "$_conda_prefix/etc/profile.d/conda.sh" ]; then
                . "$_conda_prefix/etc/profile.d/conda.sh"
            else
                export PATH="$_conda_prefix/bin:$PATH"
            fi
        fi
        unset __conda_setup
        if [ -x "$_conda_prefix/bin/mamba" ]; then
            eval "$("$_conda_prefix/bin/mamba" shell hook --shell zsh 2>/dev/null)"
        fi
        break
    fi
done
unset _conda_prefix CONDA_CANDIDATES
